include common.mak

ifeq ($(OSNAME),Msys)
EXTRADIRS=winpthreads
else
EXTRADIRS=
endif

DIRS=../bin ../lib ../tools ../vfs/app_card/$(VFS_PROGRAMS_DIR) ../vfs/$(VFS_INSTALL_DIR) ../vfs/$(VFS_STORAGE_DIR) ../vfs/app_tos/A ../vfs/app_tos/B ../vfs/app_tos/C/hd
BASE_MODULES=pilrc prcbuild $(EXTRADIRS) libpit lua libpumpkin libos BOOT Launcher Preferences Command vi LuaSyntax Japanese compat MemoPad AddressBook ToDoList DateBook SpaceTrader MineHunt gnuboy/sys/pumpkin palmbrowser palmmail netinstserver

ifeq ($(OSNAME),GNU/Linux)
ifneq ($(wildcard /usr/local/include/SDL3/SDL.h),)
WINDOW_MODULE=liblsdl3
else ifneq ($(wildcard /usr/include/SDL2/SDL.h),)
WINDOW_MODULE=liblsdl2
else ifneq ($(wildcard /usr/include/wayland-client.h),)
WINDOW_MODULE=libwwayland
else ifneq ($(wildcard /usr/include/xcb/xcb_ewmh.h),)
WINDOW_MODULE=libwxcb
else
ERROR=make_error
ERROR_MSG=Could not find SDL2, Wayland or XCB development headers
endif

ifneq ($(UNICORN),)
UNICORN_MODULE=UnicornArm
else ifneq ($(wildcard /usr/include/unicorn/unicorn.h),)
UNICORN_MODULE=UnicornArm
endif

ifneq ($(wildcard /usr/include/openssl/ssl.h),)
TLS_MODULE=liblopenssl
endif

EXTRA_MODULES=$(UNICORN_MODULE) $(WINDOW_MODULE) $(TLS_MODULE) libaalsa linux

else ifeq ($(OSNAME),filc)

WINDOW_MODULE=libwnull
UNICORN_MODULE=
EXTRA_MODULES=$(UNICORN_MODULE) $(WINDOW_MODULE) linux

else ifeq ($(OSNAME),Android)
ifneq ($(UNICORN),)
UNICORN_MODULE=UnicornArm
else ifneq ($(wildcard $(NDK)/sysroot/usr/include/unicorn/unicorn.h),)
UNICORN_MODULE=UnicornArm
endif

EXTRA_MODULES=$(UNICORN_MODULE)
else ifeq ($(OSNAME),Darwin)
ifneq ($(wildcard /usr/local/include/SDL3/SDL.h),)
WINDOW_MODULE=liblsdl3
else ifneq ($(wildcard /usr/local/include/SDL2/SDL.h),)
WINDOW_MODULE=liblsdl2
else ifneq ($(wildcard /opt/X11/include/xcb/xcb_ewmh.h),)
WINDOW_MODULE=libwxcb
endif

ifneq ($(UNICORN),)
UNICORN_MODULE=UnicornArm
else ifneq ($(wildcard /usr/local/include/unicorn/unicorn.h),)
UNICORN_MODULE=UnicornArm
endif

ifneq ($(OPENSSL),)
TLS_MODULE=liblopenssl
else ifneq ($(wildcard /opt/homebrew/opt/openssl@3/include/openssl/ssl.h /usr/local/opt/openssl@3/include/openssl/ssl.h /usr/local/opt/openssl/include/openssl/ssl.h),)
TLS_MODULE=liblopenssl
endif

EXTRA_MODULES=$(UNICORN_MODULE) $(WINDOW_MODULE) $(TLS_MODULE) linux

else ifeq ($(OSNAME),Msys)

ifneq ($(UNICORN),)
UNICORN_MODULE=UnicornArm
endif
 
# native MSYS2 (/mingw64, /mingw32) or a cross compiler sysroot (/usr/local/<machine>-pc-mingw32)
ifneq ($(wildcard /mingw64/include/openssl/ssl.h /mingw32/include/openssl/ssl.h /usr/local/$(MACHINE)-pc-mingw32/include/openssl/ssl.h),)
TLS_MODULE=liblopenssl
endif

EXTRA_MODULES=$(UNICORN_MODULE) $(TLS_MODULE) windows

else ifeq ($(OSNAME),msdosdjgpp)

# MS-DOS/DJGPP: no script engine, no shared libraries. Every application is
# compiled into a static library and linked, together with libpit, libpumpkin,
# libos and the SDL3 window provider, into one bin/pumpkinos.exe by src/msdos.
BASE_MODULES=pilrc prcbuild libpit libpumpkin libos liblsdl3 BOOT Launcher Preferences Command vi LuaSyntax MemoPad AddressBook ToDoList DateBook SpaceTrader MineHunt gnuboy/sys/pumpkin palmbrowser palmmail netinstserver liblopenssl
EXTRA_MODULES=msdos

else ifeq ($(OSNAME),vita)

# PlayStation Vita (vitasdk): same static model as MS-DOS. Every application
# is compiled into a static library and linked, together with libpit,
# libpumpkin, libos, the SDL3 window provider and the OpenSSL TLS provider,
# into one eboot.bin by src/vita, which also packs the PumpkinOS.vpk.
BASE_MODULES=pilrc prcbuild libpit libpumpkin libos liblsdl3 BOOT Launcher Preferences Command vi LuaSyntax MemoPad AddressBook ToDoList DateBook SpaceTrader MineHunt gnuboy/sys/pumpkin palmbrowser palmmail netinstserver liblopenssl
EXTRA_MODULES=vita

else ifeq ($(OSNAME),switch)

# Nintendo Switch (devkitPro): same static model as MS-DOS and the Vita.
# Every application is compiled into a static library and linked, together
# with libpit, libpumpkin, libos, the SDL3 window provider and the OpenSSL
# TLS provider, into one PumpkinOS.nro by src/switch.
BASE_MODULES=pilrc prcbuild libpit libpumpkin libos liblsdl3 BOOT Launcher Preferences Command vi LuaSyntax MemoPad AddressBook ToDoList DateBook SpaceTrader MineHunt gnuboy/sys/pumpkin palmbrowser palmmail netinstserver liblopenssl
EXTRA_MODULES=switch

else ifeq ($(OSNAME),psp)

# Sony PlayStation Portable (pspdev): same static model as MS-DOS, the Vita
# and the Switch. Every application is compiled into a static library and
# linked, together with libpit, libpumpkin, libos, the SDL3 window provider
# and the OpenSSL TLS provider, into one EBOOT.PBP by src/psp.
BASE_MODULES=pilrc prcbuild libpit libpumpkin libos liblsdl3 BOOT Launcher Preferences Command vi LuaSyntax MemoPad AddressBook ToDoList DateBook SpaceTrader MineHunt gnuboy/sys/pumpkin palmbrowser palmmail netinstserver liblopenssl
EXTRA_MODULES=psp

else ifeq ($(OSNAME),ps2)

# Sony PlayStation 2 (ps2dev): same static model as MS-DOS, the Vita, the
# Switch and the PSP. Every application is compiled into a static library and
# linked, together with libpit, libpumpkin, libos, the SDL3 window provider
# and the OpenSSL TLS provider, into one ELF by src/ps2.
BASE_MODULES=pilrc prcbuild libpit libpumpkin libos liblsdl3 BOOT Launcher Preferences Command vi LuaSyntax MemoPad AddressBook ToDoList DateBook SpaceTrader MineHunt gnuboy/sys/pumpkin palmbrowser palmmail netinstserver liblopenssl
EXTRA_MODULES=ps2

else ifeq ($(OSNAME),gamecube)

# Nintendo GameCube (devkitPro devkitPPC + libogc): same static model as the
# Vita, the Switch, the PSP and the PS2. Every application is compiled into a
# static library and linked, together with libpit, libpumpkin, libos and the
# SDL3 window provider, into one DOL by src/gamecube. No TLS provider: the
# devkitPro GameCube portlibs have no OpenSSL.
BASE_MODULES=pilrc prcbuild libpit libpumpkin libos liblsdl3 BOOT Launcher Preferences Command vi LuaSyntax MemoPad AddressBook ToDoList DateBook SpaceTrader MineHunt gnuboy/sys/pumpkin palmbrowser palmmail netinstserver
EXTRA_MODULES=gamecube

else ifeq ($(OSNAME),wii)

# Nintendo Wii (devkitPro devkitPPC + libogc): the GameCube model, linked
# into one DOL by src/wii (started from the Homebrew Channel). No TLS
# provider either: the devkitPro Wii portlibs have no OpenSSL.
BASE_MODULES=pilrc prcbuild libpit libpumpkin libos liblsdl3 BOOT Launcher Preferences Command vi LuaSyntax MemoPad AddressBook ToDoList DateBook SpaceTrader MineHunt gnuboy/sys/pumpkin palmbrowser palmmail netinstserver
EXTRA_MODULES=wii

else ifeq ($(OSNAME),ps3)

# Sony PlayStation 3 (ps3dev ppu-gcc + PSL1GHT): the static model of the
# PS2, linked into one ELF by src/ps3, which turns it into EBOOT.BIN and
# packs it as an installable PKG and a disc image (ISO). With the OpenSSL
# TLS provider (the ps3dev portlibs have OpenSSL).
BASE_MODULES=pilrc prcbuild libpit libpumpkin libos liblsdl3 BOOT Launcher Preferences Command vi LuaSyntax MemoPad AddressBook ToDoList DateBook SpaceTrader MineHunt gnuboy/sys/pumpkin palmbrowser palmmail netinstserver liblopenssl
EXTRA_MODULES=ps3

else ifeq ($(OSNAME),wiiu)

# Nintendo Wii U (devkitPro devkitPPC + wut): the static model of the Wii
# and the PS3, linked into one ELF by src/wiiu, which turns it into an RPX
# and packs it as a Homebrew Launcher / Aroma bundle (WUHB) and as a game
# image for Cemu (WUA) and for installers (the code/content/meta title
# layout). With the OpenSSL TLS provider (the wiiu portlibs have OpenSSL).
BASE_MODULES=pilrc prcbuild libpit libpumpkin libos liblsdl3 BOOT Launcher Preferences Command vi LuaSyntax MemoPad AddressBook ToDoList DateBook SpaceTrader MineHunt gnuboy/sys/pumpkin palmbrowser palmmail netinstserver liblopenssl
EXTRA_MODULES=wiiu

else ifeq ($(OSNAME),Haiku)

ifneq ($(UNICORN),)
UNICORN_MODULE=UnicornArm
endif

EXTRA_MODULES=$(UNICORN_MODULE) liblsdl2 haiku

else ifeq ($(OSNAME),Emscripten)

EMCC=$(shell which emcc)
ifeq ($(wildcard $(EMCC)),)
ERROR=make_error
ERROR_MSG=Emscripten compiler (emcc) was not found in your PATH
endif
BASE_MODULES=pilrc prcbuild libpit lua libpumpkin libos BOOT Launcher
EXTRA_MODULES=liblsdl2 emscripten

endif

MODULES=$(BASE_MODULES) $(EXTRA_MODULES)
CLEAN_MODULES=$(addsuffix _clean,$(MODULES))

all: messages $(ERROR) $(DIRS) $(MODULES)
	@echo "$(COLOR_CYAN)End$(COLOR_END)"

messages:
	@echo "$(COLOR_CYAN)Building PumpkinOS$(COLOR_END)"
	@echo "$(COLOR_CYAN)Platform:$(COLOR_END) $(OSNAME) $(BITS) bits"
	@echo "$(COLOR_CYAN)Modules:$(COLOR_END) $(MODULES)"
	@echo "$(COLOR_CYAN)Compiler flags:$(COLOR_END) $(CFLAGS)"

make_error:
	@echo "$(COLOR_RED)ERROR: $(ERROR_MSG)$(COLOR_END)"
	@exit 1

$(DIRS):
	@echo "$(COLOR_GREEN)Creating directory $@$(COLOR_END)"
	@mkdir -p $@

$(MODULES):
	@echo "$(COLOR_GREEN)Building $@$(COLOR_END)"
	@$(MAKE) -s --no-print-directory -j -f GNUMakefile -C $@

clean: $(CLEAN_MODULES)

$(CLEAN_MODULES):
	@echo "$(COLOR_GREEN)Cleaning $(subst _clean,,$@)$(COLOR_END)"
	@$(MAKE) -s --no-print-directory -f GNUMakefile -C $(subst _clean,,$@) clean

.PHONY: all clean conf $(MODULES) $(CLEAN_MODULES)
