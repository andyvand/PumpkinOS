#ifeq ($(SDL3),)
#$(error Missing SDL3 parameter (SDL3 must point to your SDL3 root directory))
#endif

include ../common.mak

PROGRAM=liblsdl3
SOURCE=liblsdl3.c

MIXER_LIBS=-lSDL3_mixer
MIXER_FLAGS=-DSDL_MIXER
#OPENGL_FLAGS=-DSDL_OPENGL

ifeq ($(OSNAME),Kernel)
STATIC=1
else ifeq ($(OSNAME),msdosdjgpp)
# DJGPP SDL3 (VESA video / Sound Blaster audio) with SDL3_mixer; the static
# libraries are linked by src/msdos
STATIC=1
CUSTOMFLAGS=$(MIXER_FLAGS)
else ifeq ($(OSNAME),vita)
# vitasdk SDL3 (GXM video, SceAudio) with SDL3_mixer; the static libraries
# are linked by src/vita
STATIC=1
CUSTOMFLAGS=$(MIXER_FLAGS)
else ifeq ($(OSNAME),switch)
# devkitPro SDL3 (EGL video, audren audio) with SDL3_mixer; the static
# libraries from portlibs are linked by src/switch
STATIC=1
CUSTOMFLAGS=$(MIXER_FLAGS)
else ifeq ($(OSNAME),psp)
# pspdev SDL3 (GU video, sceAudio) with SDL3_mixer; the static libraries
# from the pspdev sysroot are linked by src/psp
STATIC=1
CUSTOMFLAGS=$(MIXER_FLAGS)
else ifeq ($(OSNAME),ps2)
# ps2dev SDL3 (gsKit video, audsrv audio) with SDL3_mixer; the static
# libraries from the ps2dev sysroot are linked by src/ps2
STATIC=1
CUSTOMFLAGS=$(MIXER_FLAGS)
else ifeq ($(OSNAME),gamecube)
# devkitPro SDL3 (GX video, AESND audio, the GameCube controller as a
# gamepad) with SDL3_mixer; the static libraries from the gamecube portlibs
# are linked by src/gamecube
STATIC=1
CUSTOMFLAGS=$(MIXER_FLAGS)
else ifeq ($(OSNAME),wii)
# devkitPro SDL3 for the Wii (GX video, the Wiimote IR pointer as the mouse,
# Wiimotes and GameCube controllers as gamepads) with SDL3_mixer; linked by
# src/wii
STATIC=1
CUSTOMFLAGS=$(MIXER_FLAGS)
else ifeq ($(OSNAME),ps3)
# ps3dev SDL3 (RSX video, the DualShock 3 / SIXAXIS as a gamepad, no mouse)
# with SDL3_mixer; the static libraries from the ps3dev portlibs are linked
# by src/ps3
STATIC=1
CUSTOMFLAGS=$(MIXER_FLAGS)
else ifeq ($(OSNAME),wiiu)
# devkitPro SDL3 for the Wii U (GX2 video on the TV and the GamePad, the
# GamePad touch screen as the mouse, the GamePad / Pro Controllers /
# Wiimotes as gamepads, AX audio) with SDL3_mixer; linked by src/wiiu
STATIC=1
CUSTOMFLAGS=$(MIXER_FLAGS)
else ifeq ($(OSNAME),Emscripten)
STATIC=2
CUSTOMFLAGS=-s USE_SDL=3
else ifeq ($(OSNAME),Msys)
CUSTOMFLAGS=$(MIXER_FLAGS) $(OPENGL_FLAGS)
LIBS=-lSDL3 -lversion -limm32 -lgdi32 -lsetupapi -lwinmm -lole32 -loleaut32 $(MIXER_LIBS)
else
CUSTOMFLAGS=$(MIXER_FLAGS) $(OPENGL_FLAGS) -I$(SDL3)/include
#LIBS=-L$(SDL3)/build -lSDL3 $(MIXER_LIBS)
LIBS=-L/usr/local/lib -lSDL3 $(MIXER_LIBS)
endif

include ../lib.mak
