include ../common.mak

ifeq ($(OSNAME),Msys)
CUSTOMFLAGS=-I$(SRC)/font -I$(SRC)/libfatfs -I$(SRC)/libbcm2835 -I. -D_DEFAULT_SOURCE -D__STDC_WANT_SECURE_LIB__=1
else
CUSTOMFLAGS=-I$(SRC)/font -I$(SRC)/libfatfs -I$(SRC)/libbcm2835 -I. -D_DEFAULT_SOURCE
endif

SOURCE=main.c sig.c sys.c math.c malloc.c strtol.c strtoul.c ctype.c bsearch.c sha1.c base64.c printf.c string.c ptr.c debug.c builtin.c list.c sock.c websocket.c io.c loadfile.c util.c bytes.c ts.c yuv.c graphic.c vfont.c surface.c time.c timeutc.c media.c xalloc.c endianness.c gps.c vfs.c vfslocal.c filter.c telnet.c ctelnet.c login.c pterm.c bmp.c findargs.c rgb.c average.c custom_malloc.c

ifeq ($(OSNAME),Emscripten)

PROGRAM=$(BIN)/libpit.a
OBJS=$(SOURCE:%.c=%.wasm) script.wasm threadptr.wasm mutex.wasm httpc.wasm httpd.wasm template.wasm
all: $(PROGRAM)
$(PROGRAM): $(OBJS)
	@echo Creating $(PROGRAM).a
	@$(ARCMD) $(PROGRAM) $(OBJS)

else ifeq ($(OSNAME),msdosdjgpp)

# MS-DOS: cooperative threads (threadsc: setjmp/longjmp coroutines, run by
# thread_run() from libos_start; mutexnull), no script engine (the stub
# lives in src/msdos/script.c). Sockets come from Watt-32 (dosnet.o does the
# initialization). fmodl.o supplies the long double fmod missing from the
# DJGPP libm.
PROGRAM=$(BIN)/libpit.a
OBJS=$(SOURCE:%.c=%.o) threadsc.o mutexnull.o httpc.o httpd.o template.o fmodl.o dosnet.o
all: $(PROGRAM)
$(PROGRAM): $(OBJS)
	@echo Creating libpit.a
	@rm -f $(PROGRAM)
	@$(AR) -cr $(PROGRAM) $(OBJS)

else ifeq ($(OSNAME),vita)

# PlayStation Vita: cooperative threads (threadsc, like MS-DOS) and no script
# engine (the stub lives in src/vita/script.c). Sockets come from newlib on
# top of SceNet (vitanet.o initializes it). fmodl.o supplies the long double
# fmod missing from the newlib libm.
PROGRAM=$(BIN)/libpit.a
OBJS=$(SOURCE:%.c=%.o) threadsc.o mutexnull.o httpc.o httpd.o template.o fmodl.o vitanet.o
all: $(PROGRAM)
$(PROGRAM): $(OBJS)
	@echo Creating libpit.a
	@rm -f $(PROGRAM)
	@$(AR) -cr $(PROGRAM) $(OBJS)

else ifeq ($(OSNAME),switch)

# Nintendo Switch: cooperative threads (threadsc, like MS-DOS and the Vita)
# and no script engine (the stub lives in src/switch/script.c). Sockets come
# from libnx's BSD socket service (switchnet.o initializes it). The devkitA64
# newlib libm has fmodl.
PROGRAM=$(BIN)/libpit.a
OBJS=$(SOURCE:%.c=%.o) threadsc.o mutexnull.o httpc.o httpd.o template.o switchnet.o
all: $(PROGRAM)
$(PROGRAM): $(OBJS)
	@echo Creating libpit.a
	@rm -f $(PROGRAM)
	@$(AR) -cr $(PROGRAM) $(OBJS)

else ifeq ($(OSNAME),psp)

# Sony PlayStation Portable: cooperative threads (threadsc, like MS-DOS, the
# Vita and the Switch) and no script engine (the stub lives in
# src/psp/script.c). Sockets come from the pspsdk newlib glue on top of
# sceNetInet (pspnet.o loads the network modules, brings the access point
# connection up and supplies the getaddrinfo() the glue lacks). The pspdev
# newlib libm has fmodl.
PROGRAM=$(BIN)/libpit.a
OBJS=$(SOURCE:%.c=%.o) threadsc.o mutexnull.o httpc.o httpd.o template.o pspnet.o pspsys.o
all: $(PROGRAM)
$(PROGRAM): $(OBJS)
	@echo Creating libpit.a
	@rm -f $(PROGRAM)
	@$(AR) -cr $(PROGRAM) $(OBJS)

else ifeq ($(OSNAME),ps2)

# Sony PlayStation 2: cooperative threads (threadsc, like MS-DOS, the Vita,
# the Switch and the PSP) and no script engine (the stub lives in
# src/ps2/script.c). Sockets come from the ps2sdk newlib glue on top of the
# lwIP stack running on the EE (ps2net.o loads the network adapter modules
# and brings the link up with DHCP; it also supplies gai_strerror()).
# ps2sys.o implements the ftruncate() the glue lacks; ps2ramdisk.o is the
# RAM disk ("ram:", the PumpkinOS home). The newlib libm has fmodl.
PROGRAM=$(BIN)/libpit.a
OBJS=$(SOURCE:%.c=%.o) threadsc.o mutexnull.o httpc.o httpd.o template.o ps2net.o ps2sys.o ps2ramdisk.o
all: $(PROGRAM)
$(PROGRAM): $(OBJS)
	@echo Creating libpit.a
	@rm -f $(PROGRAM)
	@$(AR) -cr $(PROGRAM) $(OBJS)

else ifeq ($(OSNAME),gamecube)

# Nintendo GameCube: cooperative threads (threadsc, like MS-DOS, the Vita,
# the Switch, the PSP and the PS2) and no script engine (the stub lives in
# src/gamecube/script.c). Sockets come from libogc's BSD layer on top of
# its lwIP stack driving the Broadband Adapter (gcnet.o brings the adapter
# up with DHCP and supplies the getaddrinfo() and select() libogc lacks).
# gcsys.o has the memory log; gcramdisk.o is the ARAM RAM disk ("ram:", the
# home when no SD card adapter is present). The devkitPPC newlib libm has
# fmodl.
PROGRAM=$(BIN)/libpit.a
OBJS=$(SOURCE:%.c=%.o) threadsc.o mutexnull.o httpc.o httpd.o template.o gcnet.o gcsys.o gcramdisk.o
all: $(PROGRAM)
$(PROGRAM): $(OBJS)
	@echo Creating libpit.a
	@rm -f $(PROGRAM)
	@$(AR) -cr $(PROGRAM) $(OBJS)

else ifeq ($(OSNAME),wii)

# Nintendo Wii: the GameCube objects. The sockets come from libogc's Wii
# layer (IOS, built-in Wi-Fi / the USB ethernet adapter); gcnet.o brings the
# network up and supplies getaddrinfo(), gai_strerror() and select() (the
# name resolver itself is the IOS one). gcramdisk.o keeps the RAM disk in a
# MEM2 block instead of ARAM.
PROGRAM=$(BIN)/libpit.a
OBJS=$(SOURCE:%.c=%.o) threadsc.o mutexnull.o httpc.o httpd.o template.o gcnet.o gcsys.o gcramdisk.o
all: $(PROGRAM)
$(PROGRAM): $(OBJS)
	@echo Creating libpit.a
	@rm -f $(PROGRAM)
	@$(AR) -cr $(PROGRAM) $(OBJS)

else ifeq ($(OSNAME),ps3)

# Sony PlayStation 3: cooperative threads (threadsc, like the other consoles)
# and no script engine (the stub lives in src/ps3/script.c). Sockets come
# from PSL1GHT's libnet (LV2 sockets: descriptors tagged with
# SOCKET_FD_MASK, which select() cannot take, so the waits use poll());
# ps3net.o loads the network module, brings the connection up and supplies
# the getaddrinfo() / gai_strerror() libnet lacks (IPv4, on top of
# gethostbyname()). ps3sys.o has the memory log. ps3jmp.o replaces the C
# library's setjmp()/longjmp(), the 32-bit PowerPC ones (the upper halves of
# the callee-saved registers were lost at every task switch).
PROGRAM=$(BIN)/libpit.a
OBJS=$(SOURCE:%.c=%.o) threadsc.o mutexnull.o httpc.o httpd.o template.o ps3net.o ps3sys.o ps3jmp.o
all: $(PROGRAM)
$(PROGRAM): $(OBJS)
	@echo Creating libpit.a
	@rm -f $(PROGRAM)
	@$(AR) -cr $(PROGRAM) $(OBJS)
ps3jmp.o: ps3jmp.S
	@echo Assembling ps3jmp.S
	@$(CC) $(PS3_ARCH) -c -o $@ $<

else ifeq ($(OSNAME),wiiu)

# Nintendo Wii U: cooperative threads (threadsc, like the other consoles)
# and no script engine (the stub lives in src/wiiu/script.c). Sockets come
# from wut (nsysnet behind newlib descriptors, with select(), poll() and
# getaddrinfo()); wiiusys.o waits for the connection and has the memory log.
PROGRAM=$(BIN)/libpit.a
OBJS=$(SOURCE:%.c=%.o) threadsc.o mutexnull.o httpc.o httpd.o template.o wiiusys.o
all: $(PROGRAM)
$(PROGRAM): $(OBJS)
	@echo Creating libpit.a
	@rm -f $(PROGRAM)
	@$(AR) -cr $(PROGRAM) $(OBJS)

else ifeq ($(OSNAME),retro68)

# Classic Mac OS (Retro68): cooperative threads (threadsc, like the
# consoles) and no script engine (the stub lives in src/retro68/script.c).
# The C library has no directories, sockets or real stat(): macsys.o
# implements the POSIX calls PumpkinOS uses on top of the File Manager,
# macnet.o the BSD sockets on top of MacTCP (or Open Transport's MacTCP
# compatibility) and its name resolver.
PROGRAM=$(BIN)/libpit.a
OBJS=$(SOURCE:%.c=%.o) threadsc.o mutexnull.o httpc.o httpd.o template.o macsys.o macnet.o
all: $(PROGRAM)
$(PROGRAM): $(OBJS)
	@echo Creating libpit.a
	@rm -f $(PROGRAM)
	@$(AR) -cr $(PROGRAM) $(OBJS)

else ifeq ($(OSNAME),Kernel)

PROGRAM=$(BIN)/libpit.a
OBJS=$(SOURCE:%.c=%.o) threadnull.o mutexnull.o fmodl.o strtod.o floatscan.o intscan.o qsort.o vsnprintf.o vsscanf.o
all: $(PROGRAM)
$(PROGRAM): $(OBJS)
	@echo Creating $(PROGRAM).a
	@$(ARCMD) $(PROGRAM) $(OBJS)

else

PROGRAM=$(BIN)/libpit$(SOEXT)
OBJS=$(SOURCE:%.c=%.o) script.o threadudp.o mutex.o httpc.o httpd.o template.o
all: $(PROGRAM)
$(PROGRAM): $(OBJS)
	@echo Linking libpit$(SOEXT)
ifeq ($(OSNAME),Android)
	@$(CC) -shared -o $(PROGRAM) $(OBJS) $(EXTLIBS) $(OSLDEFS) -Wl,-soname,libpit$(SOEXT) -lm
	@$(STRIP) $(PROGRAM)
else ifeq ($(OSNAME),Darwin)
	@$(CC) -dynamiclib -o $(PROGRAM) -install_name @rpath/libpit$(SOEXT) -o $(PROGRAM) $(OBJS) $(EXTLIBS) $(OSLDEFS)
	@$(STRIP) $(PROGRAM)
	@codesign -f -s "Developer ID Application" $(PROGRAM)
else ifeq ($(OSNAME),Msys)
	@$(CC) -shared -o $(PROGRAM) $(OBJS) -L../../bin -lwinpthread $(EXTLIBS) -lm
	@$(STRIP) $(PROGRAM)
else
	@$(CC) -shared -o $(PROGRAM) $(OBJS) -lpthread $(EXTLIBS) -lm
	@$(STRIP) $(PROGRAM)
endif
endif

clean:
	@rm -f $(PROGRAM) $(OBJS)
