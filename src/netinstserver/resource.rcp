#include "resource.h"

ICONFAMILYEX
BEGIN
  BITMAP "netinst32.bmp" BPP 8 DENSITY  72 TRANSPARENT 255 255 255
  BITMAP "netinst64.bmp" BPP 8 DENSITY 144 TRANSPARENT 255 255 255
END

FORM MainForm 0 0 160 160
USABLE
NOFRAME
MENUID MainMenu
BEGIN
  TITLE "Net Install"

  LABEL "Port:" 3001 4 17 FONT 1
  FIELD portFld 32 17 36 AUTO SINGLELINE MAXCHARS 5 EDITABLE UNDERLINED NUMERIC
  CHECKBOX "Auto start" autoChk 82 16 AUTO AUTO FONT 0

  BUTTON "Start" startBtn 4 31 AUTO 12
  BUTTON "Stop"  stopBtn  4 31 AUTO 12 NONUSABLE

  GADGET ID statusGad 44 32 112 12
  GADGET ID logGad 2 48 156 98
  GRAFFITISTATEINDICATOR 148 149
END

MENU MainMenu
BEGIN
  PULLDOWN "Options"
  BEGIN
    MENUITEM "Clear Log"  clearLogCmd "L"
    MENUITEM "About Net Install" aboutCmd
  END
END

ALERT ErrorAlert
ERROR
BEGIN
  TITLE "Net Install"
  MESSAGE "^1"
  BUTTONS "OK"
END

VERSION "1.0"
