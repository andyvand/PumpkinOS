#include "resource.h"

ICONFAMILYEX
BEGIN
  BITMAP "mail32.bmp" BPP 8 DENSITY  72 TRANSPARENT 255 255 255
  BITMAP "mail64.bmp" BPP 8 DENSITY 144 TRANSPARENT 255 255 255
END

FORM MainForm 0 0 160 160
USABLE
NOFRAME
MENUID MainMenu
BEGIN
  TITLE "Mail"
  POPUPTRIGGER "Folder" folderTrig 112 1 46 12 RIGHTANCHOR
  LIST "" folderList 56 1 102 AUTO NONUSABLE VISIBLEITEMS 8
  POPUPLIST folderTrig folderList
  GADGET ID msgGad 0 15 153 132
  SCROLLBAR ID msgScl 153 15 7 132 VALUE 0 MIN 0 MAX 0 PAGESIZE 11
  BUTTON "New" newBtn 1 147 AUTO 12
  BUTTON "Get Mail" getBtn PREVRIGHT+4 147 AUTO 12
  BUTTON "Account" accountBtn PREVRIGHT+4 147 AUTO 12
END

MENU MainMenu
BEGIN
  PULLDOWN "Message"
  BEGIN
    MENUITEM "New"         newCmd     "N"
    MENUITEM "Get Mail"    getCmd     "G"
    MENUITEM SEPARATOR
    MENUITEM "Folders..."  foldersCmd "F"
  END
  PULLDOWN "Options"
  BEGIN
    MENUITEM "Account..."  accountCmd "A"
    MENUITEM "About Mail"  aboutCmd
  END
END

FORM ViewForm 0 0 160 160
USABLE
NOFRAME
MENUID ViewMenu
BEGIN
  TITLE "Message"
  GADGET ID headerGad 0 15 160 44
  FIELD bodyFld 0 60 153 86 NONEDITABLE MULTIPLELINES MAXCHARS 32000 HASSCROLLBAR
  SCROLLBAR ID bodyScl 153 60 7 86 VALUE 0 MIN 0 MAX 0 PAGESIZE 7
  BUTTON "Done" doneBtn 1 147 AUTO 12
  BUTTON "Reply" replyBtn PREVRIGHT+4 147 AUTO 12
  BUTTON "Fwd" fwdBtn PREVRIGHT+4 147 AUTO 12
  BUTTON "Delete" delBtn PREVRIGHT+4 147 AUTO 12
END

MENU ViewMenu
BEGIN
  PULLDOWN "Message"
  BEGIN
    MENUITEM "Reply"    replyCmd "R"
    MENUITEM "Forward"  fwdCmd   "W"
    MENUITEM "Delete"   delCmd   "D"
    MENUITEM SEPARATOR
    MENUITEM "Done"     doneCmd  "Q"
  END
  PULLDOWN "Options"
  BEGIN
    MENUITEM "About Mail" aboutCmd
  END
END

FORM ComposeForm 0 0 160 160
USABLE
NOFRAME
MENUID ComposeMenu
BEGIN
  TITLE "New Message"
  LABEL "To:" toLbl 1 17 FONT 1
  FIELD toFld 30 17 128 11 SINGLELINE MAXCHARS 255 EDITABLE UNDERLINED
  LABEL "Cc:" ccLbl 1 29 FONT 1
  FIELD ccFld 30 29 128 11 SINGLELINE MAXCHARS 255 EDITABLE UNDERLINED
  LABEL "Subj:" subjLbl 1 41 FONT 1
  FIELD subjFld 30 41 128 11 SINGLELINE MAXCHARS 120 EDITABLE UNDERLINED
  FIELD cbodyFld 0 54 153 92 MULTIPLELINES MAXCHARS 8000 EDITABLE UNDERLINED HASSCROLLBAR
  SCROLLBAR ID cbodyScl 153 54 7 92 VALUE 0 MIN 0 MAX 0 PAGESIZE 8
  BUTTON "Send" sendBtn 1 147 AUTO 12
  BUTTON "Cancel" cancelBtn PREVRIGHT+4 147 AUTO 12
  GRAFFITISTATEINDICATOR 148 149
END

MENU ComposeMenu
BEGIN
  PULLDOWN "Message"
  BEGIN
    MENUITEM "Send"     sendCmd    "M"
    MENUITEM "Discard"  discardCmd
  END
  PULLDOWN "Edit"
  BEGIN
    MENUITEM "Undo"       10000 "U"
    MENUITEM "Cut"        10001 "X"
    MENUITEM "Copy"       10002 "C"
    MENUITEM "Paste"      10003 "P"
    MENUITEM "Select All" 10004 "S"
  END
  PULLDOWN "Options"
  BEGIN
    MENUITEM "About Mail" aboutCmd
  END
END

FORM AccountForm 0 0 160 160
USABLE
NOFRAME
BEGIN
  TITLE "Account"
  LABEL "Name:" nameLbl 1 16 FONT 1
  FIELD nameFld 42 16 116 11 SINGLELINE MAXCHARS 63 EDITABLE UNDERLINED
  LABEL "E-mail:" emailLbl 1 28 FONT 1
  FIELD emailFld 42 28 116 11 SINGLELINE MAXCHARS 95 EDITABLE UNDERLINED
  LABEL "User:" userLbl 1 40 FONT 1
  FIELD userFld 42 40 116 11 SINGLELINE MAXCHARS 95 EDITABLE UNDERLINED
  LABEL "Pass:" passLbl 1 52 FONT 1
  FIELD passFld 42 52 116 11 SINGLELINE MAXCHARS 63 EDITABLE UNDERLINED
  POPUPTRIGGER "IMAP4" protoTrig 0 63 40 12 LEFTANCHOR
  LIST "IMAP4" "POP3" protoList 0 63 44 AUTO NONUSABLE VISIBLEITEMS 2
  POPUPLIST protoTrig protoList
  FIELD imapHostFld 42 64 84 11 SINGLELINE MAXCHARS 95 EDITABLE UNDERLINED
  FIELD imapPortFld 130 64 28 11 SINGLELINE MAXCHARS 5 EDITABLE UNDERLINED NUMERIC
  LABEL "Secure:" imapSecLbl 1 76 FONT 1
  POPUPTRIGGER "SSL/TLS" imapSecTrig 42 76 70 12 LEFTANCHOR
  LIST "None" "STARTTLS" "SSL/TLS" imapSecList 42 76 60 AUTO NONUSABLE VISIBLEITEMS 3
  POPUPLIST imapSecTrig imapSecList
  LABEL "SMTP:" smtpLbl 1 89 FONT 1
  FIELD smtpHostFld 42 89 84 11 SINGLELINE MAXCHARS 95 EDITABLE UNDERLINED
  FIELD smtpPortFld 130 89 28 11 SINGLELINE MAXCHARS 5 EDITABLE UNDERLINED NUMERIC
  LABEL "Secure:" smtpSecLbl 1 101 FONT 1
  POPUPTRIGGER "SSL/TLS" smtpSecTrig 42 101 70 12 LEFTANCHOR
  LIST "None" "STARTTLS" "SSL/TLS" smtpSecList 42 101 60 AUTO NONUSABLE VISIBLEITEMS 3
  POPUPLIST smtpSecTrig smtpSecList
  LABEL "Fetch:" fetchLbl 1 114 FONT 1
  FIELD fetchFld 42 114 24 11 SINGLELINE MAXCHARS 3 EDITABLE UNDERLINED NUMERIC
  LABEL "newest messages" fetchUnitLbl 70 114 FONT 0
  BUTTON "OK" okBtn 1 147 AUTO 12
  BUTTON "Cancel" acancelBtn PREVRIGHT+4 147 AUTO 12
  GRAFFITISTATEINDICATOR 148 149
END

FORM WaitForm 2 94 156 64
MODAL
SAVEBEHIND
USABLE
BEGIN
  TITLE "Mail"
  GADGET ID waitGad 4 20 148 22
  BUTTON "Cancel" waitCancelBtn CENTER 46 AUTO 12
END

ALERT ErrorAlert
ERROR
BEGIN
  TITLE "Mail"
  MESSAGE "^1"
  BUTTONS "OK"
END

ALERT InfoAlert
INFORMATION
BEGIN
  TITLE "Mail"
  MESSAGE "^1"
  BUTTONS "OK"
END

ALERT ConfirmAlert
CONFIRMATION
BEGIN
  TITLE "Mail"
  MESSAGE "^1"
  BUTTONS "Yes" "No"
END

ALERT NoAccountAlert
INFORMATION
BEGIN
  TITLE "Welcome"
  MESSAGE "No mail account is set up yet. Enter your e-mail address, password and the incoming (IMAP4 or POP3) and SMTP servers of your provider."
  BUTTONS "OK"
END

VERSION "1.0"
