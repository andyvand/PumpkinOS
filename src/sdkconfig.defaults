CONFIG_ESP_SYSTEM_MEMPROT_FEATURE_LOCK=n
CONFIG_ELF_DYNAMIC_LOAD_SHARED_OBJECT=y
CONFIG_ESP_SYSTEM_MEMPROT_PMS_LOCK=n
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_ELF_LOADER_LOAD_PSRAM=y
CONFIG_ELF_LOADER_BUS_ADDRESS_MIRROR=y
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_ESP_TASK_WDT_INIT=n
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Touch rotation must match display rotation. The display config sets
# CONFIG_BSP_DISPLAY_ROTATION_MIRROR_X; touch needs the same MIRROR_X
# (not MIRROR_Y) so taps line up with what's drawn underneath them.
CONFIG_BSP_TOUCH_ROTATION_MIRROR_X=y
# CONFIG_BSP_TOUCH_ROTATION_MIRROR_Y is not set
